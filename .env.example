# Port the API listens on
PORT=3000
# Origin allowed by CORS (the Vite dev server by default)
FRONTEND_URL=http://localhost:5173
# Fixed "today" of the demo; every deadline is computed against it
DEMO_TODAY=2026-11-21
# "miejscowość" printed next to signature dates in the downloaded sheet (PDF/DOCX).
# Unset = Warszawa (demo value).
# OFFICE_PLACE=Warszawa
# Optional PostgreSQL. Unset = in-memory storage (data lost on restart).
# Migrations run automatically at startup. Local DB: `docker compose up -d db`
# DATABASE_URL=postgres://hacknation:hacknation@localhost:5432/hacknation
# HS256 key for sign-in tokens, 32+ bytes (openssl rand -base64 32). Without it a
# dev-only default is used and a warning is logged: always set it in production.
# JWT_SECRET=
# Optional AI assistant LLM: any free OpenAI-compatible chat endpoint.
# Without these the assistant answers extractively (quotes + citations).
# Local Ollama: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b  (no key)
# Groq free tier: LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
