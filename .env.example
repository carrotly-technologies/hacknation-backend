# Port the API listens on
PORT=3000
# Origin allowed by CORS (the Vite dev server by default)
FRONTEND_URL=http://localhost:5173
# Fixed "today" of the demo; every deadline is computed against it
DEMO_TODAY=2026-11-21
# "miejscowość" printed next to signature dates in the downloaded sheet (PDF/DOCX).
# Unset = Warszawa (demo value).
# OFFICE_PLACE=Warszawa
# Optional PostgreSQL. Unset = in-memory storage (data lost on restart).
# Migrations run automatically at startup. Local DB: `docker compose up -d db`
# DATABASE_URL=postgres://hacknation:hacknation@localhost:5432/hacknation
# HS256 key for sign-in tokens, 32+ bytes (openssl rand -base64 32). Without it a
# dev-only default is used and a warning is logged: always set it in production.
# JWT_SECRET=
# AES-256-GCM key for free text stored in PostgreSQL (journal notes and S-D-R
# observations), 32 bytes in base64 (openssl rand -base64 32). Without it a
# dev-only default is used and a warning is logged: always set it in production
# and keep it outside the database. Data written with the dev key is
# re-encrypted with this key at the next start.
# DATA_ENCRYPTION_KEY=
# Retention (docs/rodo/retencja.md): cases that ended and journal entries older
# than this many years are anonymized / deleted, at startup, every 24 h and with
# `npm run retention`. Default 10.
# RETENTION_YEARS=10
# Secret of the activity monitor (frontend page /aktywnosc, GET /api/monitor/*,
# header X-Monitor-Token). Unset = the monitor answers 404; the log is still written
# (IP, browser, session, account login, path and status; never bodies; kept 30 days).
# MONITOR_TOKEN=
# Rate limits (429 above them), per minute. General: per route and client (signed-in
# account, otherwise IP). Sign-in and the assessed person's confirmation: per IP.
# RATE_LIMIT_PER_MINUTE=100
# RATE_LIMIT_LOGIN_PER_MINUTE=5
# Proxies whose X-Forwarded-For gives the client IP (Express "trust proxy").
# Default: any proxy on a private network (Coolify, nginx, Traefik in front of the
# container). Set to false when clients connect to the API directly.
# TRUST_PROXY=loopback, linklocal, uniquelocal
# Largest request body; bigger answers 413.
# BODY_LIMIT=1mb
# Optional AI assistant LLM: any free OpenAI-compatible chat endpoint.
# Without these the assistant answers extractively (quotes + citations).
# Local Ollama: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b  (no key)
# Groq free tier: LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
